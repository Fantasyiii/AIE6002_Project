# --- LLM provider (choose one) ---

# Option A: DeepSeek (recommended, OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Option B: Any other OpenAI-compatible provider (Qwen, SiliconFlow, OpenRouter, etc.)
# DEEPSEEK_API_KEY=<your_key>
# DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # Qwen example
# DEEPSEEK_MODEL=qwen-plus

# Option C: OpenAI official
OPENAI_API_KEY=
